{
  "name": "@nils0xff/sichr",
  "version": "0.1.4",
  "description": "A simple CLI tool to analyze password strength and generate secure passwords",
  "homepage": "https://github.com/Nils0xFF/sichr#readme",
  "bugs": {
    "url": "https://github.com/Nils0xFF/sichr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nils0xFF/sichr.git"
  },
  "license": "MIT",
  "author": "Nils Geschwinde",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sichr": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --watch src/index.ts",
    "dev:validate": "tsx --watch src/index.ts validate",
    "dev:generate": "tsx --watch src/index.ts generate",
    "lint": "npx eslint src",
    "build": "tsc",
    "start": "tsc && node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "release": "release-it"
  },
  "dependencies": {
    "@optique/core": "^1.2.2",
    "@optique/discover": "^1.2.2",
    "@optique/inquirer": "^1.2.2",
    "@optique/run": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/inquirer": "^9.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "3.9.6",
    "release-it": "^21.0.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
