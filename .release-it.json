{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "tag": true,
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}"
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false,
    "publishArgs": ["--access", "public"]
  }
}
